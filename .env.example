# LLM provider: gemini | openai
LLM_PROVIDER=gemini

# Gemini (Google AI Studio) — used when LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
# Free tier: prefer 2.5-flash (separate quota from gemini-3.8-flash). If 404, try gemini-3.8-flash.
GEMINI_MODEL=gemini-2.5-flash
# Required for Gemini 3.x tool calling only
GEMINI_INCLUDE_THOUGHTS=false

# Fewer tool calls = fewer API round-trips (important on free tier ~5 RPM)
MAX_TOOL_CALLS=1
RATE_LIMIT_RETRIES=3

# OpenAI — used when LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
